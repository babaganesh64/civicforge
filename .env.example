# Database
DATABASE_URL=jdbc:postgresql://postgres:5432/civicforge
DATABASE_USERNAME=civicforge
DATABASE_PASSWORD=civicforge_dev_password
POSTGRES_DB=civicforge
POSTGRES_USER=civicforge
POSTGRES_PASSWORD=civicforge_dev_password

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT
JWT_SECRET=change-me-in-production-must-be-at-least-256-bits-long-really
JWT_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Next.js
NEXT_PUBLIC_API_URL=http://localhost:8080
NEXT_PUBLIC_APP_NAME=CivicForge

# MinIO (S3-compatible)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin123
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=civicforge-files
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin123
AWS_REGION=us-east-1

# AI Service
AI_SERVICE_URL=http://ai-service:8000
AI_ENABLED=false

# Application
APP_ENV=development
